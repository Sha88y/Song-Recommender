# No API keys required for MVP
# Future: add SPOTIFY_CLIENT_ID and SPOTIFY_CLIENT_SECRET if needed

# Server config
# Local-only example:
# SONGSUGGEST_HOST=127.0.0.1

# VM/LAN example:
# SONGSUGGEST_HOST=0.0.0.0
# SONGSUGGEST_ACCESS_HOST=<your-vm-or-lan-ip>

# Optional port override
# SONGSUGGEST_PORT=8000
